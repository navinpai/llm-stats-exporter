{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "LLM API usage and cost from llm-stats-exporter (https://github.com/navinpai/llm-stats-exporter)",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "llm-stats-exporter on GitHub",
      "tooltip": "Source of these metrics",
      "type": "link",
      "url": "https://github.com/navinpai/llm-stats-exporter"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(llm_monthly_cost_usd{provider=~\"$provider\",account=~\"$account\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Month-to-date billed cost",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(llm_monthly_estimated_cost_usd{provider=~\"$provider\",account=~\"$account\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Month-to-date estimated cost",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Billed cost for the last day of the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(llm_cost_usd{provider=~\"$provider\",account=~\"$account\",date=\"${__to:date:YYYY-MM-DD}\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Billed cost (latest day)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Estimated cost (tokens × pricing table) for the last day of the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(llm_estimated_cost_usd{provider=~\"$provider\",account=~\"$account\",date=\"${__to:date:YYYY-MM-DD}\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Estimated cost (latest day)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Month-to-date billed spend as reported by the provider cost APIs. Resets at the start of each month.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (provider, account) (llm_monthly_cost_usd{provider=~\"$provider\",account=~\"$account\"})",
          "legendFormat": "{{provider}} / {{account}}",
          "refId": "A"
        }
      ],
      "title": "Month-to-date billed spend by provider / account",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 7,
      "panels": [],
      "title": "Cost breakdown",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Grouped by the exporter's `date` label, so only days inside the lookback window (LOOKBACK_DAYS + today) appear.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80 },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "hidden" },
        "orientation": "auto",
        "showValue": "auto",
        "tooltip": { "mode": "single" },
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "expr": "sum by (date) (llm_cost_usd{provider=~\"$provider\",account=~\"$account\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Billed cost by day",
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "merge", "options": {} },
        { "id": "sortBy", "options": { "sort": [{ "field": "date" }] } },
        {
          "id": "organize",
          "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "Billed (USD)" } }
        }
      ],
      "type": "barchart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Token counts × pricing table, summed per day.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80 },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 9,
      "options": {
        "legend": { "displayMode": "hidden" },
        "orientation": "auto",
        "showValue": "auto",
        "tooltip": { "mode": "single" },
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "expr": "sum by (date) (llm_estimated_cost_usd{provider=~\"$provider\",account=~\"$account\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Estimated cost by day",
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "merge", "options": {} },
        { "id": "sortBy", "options": { "sort": [{ "field": "date" }] } },
        {
          "id": "organize",
          "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "Estimated (USD)" } }
        }
      ],
      "type": "barchart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 22 },
      "id": 10,
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "topk(10, sum by (api_key_name) (llm_monthly_estimated_cost_usd{provider=~\"$provider\",account=~\"$account\"}))",
          "instant": true,
          "legendFormat": "{{api_key_name}}",
          "refId": "A"
        }
      ],
      "title": "Top API keys — month-to-date estimated cost",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Summed over the exporter's lookback window.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 22 },
      "id": 11,
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "topk(10, sum by (model) (llm_estimated_cost_usd{provider=~\"$provider\",account=~\"$account\"}))",
          "instant": true,
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "title": "Top models — estimated cost (window)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Provider billing line items, summed over the exporter's lookback window.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 22 },
      "id": 12,
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "topk(10, sum by (line_item) (llm_cost_usd{provider=~\"$provider\",account=~\"$account\"}))",
          "instant": true,
          "legendFormat": "{{line_item}}",
          "refId": "A"
        }
      ],
      "title": "Billed cost by line item (window)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "MTD billed (USD)" },
            "properties": [{ "id": "unit", "value": "currencyUSD" }]
          }
        ]
      },
      "gridPos": { "h": 7, "w": 16, "x": 0, "y": 30 },
      "id": 13,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "MTD billed (USD)" }]
      },
      "targets": [
        {
          "expr": "sum by (provider, account, project_name) (llm_monthly_cost_usd{provider=~\"$provider\",account=~\"$account\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Month-to-date billed cost by project / workspace",
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "MTD billed (USD)" } }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Summed over the exporter's lookback window. Batch traffic is estimated at 50% of standard rates; flex/priority use standard rates (billed cost is the source of truth there).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 30 },
      "id": 26,
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "sum by (service_tier) (llm_estimated_cost_usd{provider=~\"$provider\",account=~\"$account\"})",
          "instant": true,
          "legendFormat": "{{service_tier}}",
          "refId": "A"
        }
      ],
      "title": "Estimated cost by service tier (window)",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "id": 14,
      "panels": [],
      "title": "Usage",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "id": 15,
      "options": {
        "legend": { "displayMode": "hidden" },
        "orientation": "auto",
        "showValue": "auto",
        "tooltip": { "mode": "single" },
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "expr": "sum by (date) (llm_usage_tokens{provider=~\"$provider\",account=~\"$account\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Tokens by day",
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "merge", "options": {} },
        { "id": "sortBy", "options": { "sort": [{ "field": "date" }] } },
        {
          "id": "organize",
          "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "Tokens" } }
        }
      ],
      "type": "barchart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Summed over the exporter's lookback window. `input` is uncached input; `input + cache_read` = total prompt tokens.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "id": 16,
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "sum by (token_type) (llm_usage_tokens{provider=~\"$provider\",account=~\"$account\"})",
          "instant": true,
          "legendFormat": "{{token_type}}",
          "refId": "A"
        }
      ],
      "title": "Tokens by type (window)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "cache_read / (input + cache_read) over the lookback window.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-RdYlGr" },
          "max": 1,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "id": 17,
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "sum by (model) (llm_usage_tokens{provider=~\"$provider\",account=~\"$account\",token_type=\"cache_read\"}) / sum by (model) (llm_usage_tokens{provider=~\"$provider\",account=~\"$account\",token_type=~\"input|cache_read\"})",
          "instant": true,
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "title": "Cache hit ratio by model",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "OpenAI only — Anthropic's usage API does not report request counts.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "id": 18,
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "topk(10, sum by (model) (llm_requests{provider=~\"$provider\",account=~\"$account\"}))",
          "instant": true,
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "title": "Requests by model (window)",
      "type": "bargauge"
    },
    {
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 54 },
      "id": 19,
      "panels": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
              "mappings": [
                {
                  "options": {
                    "0": { "color": "red", "text": "DOWN" },
                    "1": { "color": "green", "text": "UP" }
                  },
                  "type": "value"
                }
              ],
              "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
            },
            "overrides": []
          },
          "gridPos": { "h": 4, "w": 6, "x": 0, "y": 55 },
          "id": 20,
          "options": {
            "colorMode": "value",
            "graphMode": "none",
            "orientation": "auto",
            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
            "textMode": "value_and_name"
          },
          "targets": [
            {
              "expr": "llm_exporter_up{provider=~\"$provider\",account=~\"$account\"}",
              "instant": true,
              "legendFormat": "{{provider}} / {{account}}",
              "refId": "A"
            }
          ],
          "title": "Exporter up",
          "type": "stat"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 900 },
                  { "color": "red", "value": 3600 }
                ]
              },
              "unit": "s"
            },
            "overrides": []
          },
          "gridPos": { "h": 4, "w": 6, "x": 6, "y": 55 },
          "id": 21,
          "options": {
            "colorMode": "value",
            "graphMode": "none",
            "orientation": "auto",
            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
            "textMode": "value_and_name"
          },
          "targets": [
            {
              "expr": "time() - llm_exporter_last_success_timestamp_seconds{provider=~\"$provider\",account=~\"$account\"}",
              "instant": true,
              "legendFormat": "{{provider}} / {{account}}",
              "refId": "A"
            }
          ],
          "title": "Time since last successful poll",
          "type": "stat"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "red", "value": null },
                  { "color": "green", "value": 1 }
                ]
              }
            },
            "overrides": []
          },
          "gridPos": { "h": 4, "w": 6, "x": 12, "y": 55 },
          "id": 22,
          "options": {
            "colorMode": "value",
            "graphMode": "none",
            "orientation": "auto",
            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
            "textMode": "value_and_name"
          },
          "targets": [
            {
              "expr": "llm_pricing_models",
              "instant": true,
              "legendFormat": "{{source}}",
              "refId": "A"
            }
          ],
          "title": "Pricing table models",
          "type": "stat"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 172800 }
                ]
              },
              "unit": "s"
            },
            "overrides": []
          },
          "gridPos": { "h": 4, "w": 6, "x": 18, "y": 55 },
          "id": 23,
